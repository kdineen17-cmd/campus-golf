{
  "expo": {
    "name": "Campus Golf",
    "slug": "campus-golf",
    "owner": "kdineen17s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "campusgolf",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2473d317-40f7-4490-ad92-4b3163d83c74"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campusgolf.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Campus Golf uses your location to record tee and hole positions while you build a course, and to track your position while you play."
      }
    },
    "android": {
      "package": "com.campusgolf.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F3E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDRfe0OcIjeXz2mzi4-IfRX912obUf6j08"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Campus Golf uses your location to record tee and hole positions while you build a course, and to track your position while you play."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3E6",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Campus Golf uses your camera to take a tee-box photo for each hole, so you can mark the flag position."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2473d317-40f7-4490-ad92-4b3163d83c74"
      }
    }
  }
}
