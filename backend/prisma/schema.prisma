generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  courses Course[]
  rounds  Round[]

  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")
}

model Course {
  id          String   @id @default(cuid())
  name        String
  description String?
  location    String?
  creatorId   String
  createdAt   DateTime @default(now())

  creator User    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  holes   Hole[]
  rounds  Round[]

  @@index([creatorId])
}

model Hole {
  id       String  @id @default(cuid())
  courseId String
  index    Int
  name     String?
  par      Int
  teeLat   Float
  teeLng   Float
  holeLat  Float
  holeLng  Float
  // A tee-box photo (data URL) with the flag position marked as a fraction
  // (0-1) of the image's width/height, so it stays correct at any display size.
  photo    String?
  flagX    Float?
  flagY    Float?

  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  roundHoles RoundHole[]

  @@unique([courseId, index])
}

model Round {
  id            String    @id @default(cuid())
  courseId      String
  playerId      String
  totalStrokes  Int
  durationSecs  Int?
  completedAt   DateTime  @default(now())

  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  player     User        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  roundHoles RoundHole[]

  @@index([courseId, totalStrokes])
  @@index([playerId])
}

model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  addresseeId String
  // "pending" until the addressee accepts; accepted friendships are
  // mutual (either side can view/unfriend). Declined/cancelled requests
  // are deleted rather than tracked.
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model RoundHole {
  id      String @id @default(cuid())
  roundId String
  holeId  String
  strokes Int

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  hole  Hole  @relation(fields: [holeId], references: [id], onDelete: Cascade)

  @@unique([roundId, holeId])
}
